<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- The site is dark-only, so the app is too (no DayNight switching). -->
    <style name="Theme.Watched" parent="Theme.AppCompat.NoActionBar">
        <item name="colorPrimary">@color/accent_500</item>
        <item name="colorPrimaryDark">@color/bg_base</item>
        <item name="colorAccent">@color/accent_400</item>
        <item name="android:windowBackground">@color/bg_base</item>
        <item name="android:statusBarColor">@color/bg_base</item>
        <item name="android:navigationBarColor">@color/bg_base</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:textColorPrimary">@color/fg</item>
        <item name="android:textColorSecondary">@color/fg_muted</item>
        <item name="android:colorEdgeEffect">@color/accent_500</item>
    </style>

    <style name="Theme.Watched.Splash" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">@color/bg_base</item>
        <item name="windowSplashScreenAnimatedIcon">@mipmap/ic_launcher_foreground</item>
        <item name="windowSplashScreenAnimationDuration">400</item>
        <item name="postSplashScreenTheme">@style/Theme.Watched</item>
        <item name="android:statusBarColor">@color/bg_base</item>
        <item name="android:navigationBarColor">@color/bg_base</item>
    </style>
</resources>
